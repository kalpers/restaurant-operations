# Copy to .env for local development. Never commit .env.
# These credentials are for the local Docker database only.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Application database connection.
DATABASE_URL=postgresql://restaurant_app:local_dev_password@localhost:5432/restaurant_ops

# Used by docker-compose.yml to initialize the local database.
# Keep these consistent with DATABASE_URL.
POSTGRES_DB=restaurant_ops
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=local_dev_password
