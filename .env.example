# Copy to .env for local development. Never commit .env.
# These credentials are for the local Docker database only.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Signs session tokens. Required to sign in. Generate your own and never commit it:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# Application database connection.
DATABASE_URL=postgresql://restaurant_app:local_dev_password@localhost:5432/restaurant_ops

# Isolated integration and E2E test database. Recreated on every test run.
# Must be <DATABASE_URL database>_test on the same local server.
# Never point this at a shared or production database.
TEST_DATABASE_URL=postgresql://restaurant_app:local_dev_password@localhost:5432/restaurant_ops_test

# Optional. Where employee documents are stored locally. Must stay outside public/.
# EMPLOYEE_DOCUMENT_STORAGE_PATH=.local/hr-files
# Optional. Largest employee document in bytes. Defaults to 10 MiB; at most 50 MiB.
# EMPLOYEE_DOCUMENT_MAX_BYTES=10485760

# Optional. How often (ms) the outbox processor publishes committed realtime events.
# Defaults to 1000; 0 turns it off.
# OUTBOX_POLL_INTERVAL_MS=1000
# Optional. Failed publishes back off (1 s doubling, capped at 5 min); after this many
# attempts an event is dead-lettered and shown on Admin -> System health. Defaults to 10.
# OUTBOX_MAX_ATTEMPTS=10
# Optional. Days published outbox events are kept before maintenance deletes them. Defaults to 7.
# OUTBOX_RETENTION_DAYS=7
# Optional. How often (ms) the in-process maintenance runner purges expired rows.
# Defaults to 3600000 (one hour); 0 turns it off. `npm run maintenance` runs it once.
# MAINTENANCE_INTERVAL_MS=3600000

# Optional. Sign-in lockout: this many failures within the window lock the account (and
# unknown emails alike) for the duration. Defaults: 5 failures, 15 minutes, 15 minutes.
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_WINDOW_MINUTES=15
# AUTH_LOCKOUT_DURATION_MINUTES=15
# Optional. Set ONLY behind a trusted proxy that writes this header, to also throttle per
# client IP (rightmost entry). Unset by default, because the header can be spoofed.
# AUTH_CLIENT_IP_HEADER=x-forwarded-for
# AUTH_IP_THRESHOLD=50

# Used by docker-compose.yml to initialize the local database.
# Keep these consistent with DATABASE_URL.
POSTGRES_DB=restaurant_ops
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=local_dev_password
