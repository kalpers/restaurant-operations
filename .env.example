# Copy to .env for local development. Never commit .env.
# These credentials are for the local Docker database only.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Signs session tokens. Required to sign in. Generate your own and never commit it:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=

# Application database connection.
DATABASE_URL=postgresql://restaurant_app:local_dev_password@localhost:5432/restaurant_ops

# Isolated integration and E2E test database. Recreated on every test run.
# Must be <DATABASE_URL database>_test on the same local server.
# Never point this at a shared or production database.
TEST_DATABASE_URL=postgresql://restaurant_app:local_dev_password@localhost:5432/restaurant_ops_test

# Optional. Where employee documents are stored locally. Must stay outside public/.
# EMPLOYEE_DOCUMENT_STORAGE_PATH=.local/hr-files
# Optional. Largest employee document in bytes. Defaults to 10 MiB; at most 50 MiB.
# EMPLOYEE_DOCUMENT_MAX_BYTES=10485760

# Optional. How often (ms) the outbox processor publishes committed realtime events.
# Defaults to 1000; 0 turns it off.
# OUTBOX_POLL_INTERVAL_MS=1000

# Used by docker-compose.yml to initialize the local database.
# Keep these consistent with DATABASE_URL.
POSTGRES_DB=restaurant_ops
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=local_dev_password
